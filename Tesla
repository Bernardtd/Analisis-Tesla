    <!-- AUDIO SYNTH & CANVAS JS LOGIC -->
    <script>
        // Global Presentation State
        let currentSlide = 0;
        const totalSlides = 6;
        let audioEnabled = true;

        // Slide Navigation
        function updateSlideUI() {
            for (let i = 0; i < totalSlides; i++) {
                const el = document.getElementById(`slide-${i}`);
                if (el) {
                    if (i === currentSlide) {
                        el.classList.remove('hidden');
                        setTimeout(() => el.classList.add('slide-active'), 10);
                    } else {
                        el.classList.remove('slide-active');
                        el.classList.add('hidden');
                    }
                }
            }

            document.getElementById('slideIndicator').innerText = `0${currentSlide + 1} / 0${totalSlides}`;
            logCLI(`Navigated to Slide ${currentSlide + 1}: ${getSlideTitle(currentSlide)}`);
            playBeep(440, 0.05);
        }

        function changeSlide(direction) {
            currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
            updateSlideUI();
        }

        function getSlideTitle(index) {
            const titles = [
                "Portada UNIPLEA & Tesla Overview",
                "Análisis del Consumidor & Excedente",
                "Producción, Eficiencia y Costos",
                "Estructura de Mercado Oligopólica",
                "Riesgo Económico y Financiero",
                "Propuesta de Solución & Conclusiones"
            ];
            return titles[index] || "Tesla HUD";
        }

        function logCLI(message) {
            const cli = document.getElementById('cliOutput');
            if (cli) {
                const time = new Date().toLocaleTimeString();
                cli.innerHTML = `<span class="text-gray-500">[${time}]</span> <span class="text-greenNeon">> ${message}</span>`;
            }
        }

        // Web Audio API Synthesizer (No external sound files required)
        let audioCtx = null;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            return audioCtx;
        }

        function toggleAudioSynth() {
            audioEnabled = !audioEnabled;
            const text = document.getElementById('soundText');
            const icon = document.getElementById('soundIcon');
            if (audioEnabled) {
                text.innerText = "AUDIO ON";
                icon.className = "fa-solid fa-volume-high";
                logCLI("System Audio Synthesizer Enabled");
            } else {
                text.innerText = "AUDIO OFF";
                icon.className = "fa-solid fa-volume-xmark";
                logCLI("System Audio Muted");
            }
        }

        function playBeep(freq, duration) {
            if (!audioEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(0.05, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch (e) {
                // Audio context block handling
            }
        }

        function playRocketSound() {
            if (!audioEnabled) return;
            try {
                const ctx = getAudioContext();
                // Noise buffer for rocket engine rumble
                const bufferSize = ctx.sampleRate * 1.5;
                const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, ctx.currentTime);
                filter.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 1.5);

                const gain = ctx.createGain();
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.5);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(ctx.destination);

                noise.start();
            } catch (e) {}
        }

        // Keyboard Arrow Navigation
        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'Space') {
                changeSlide(1);
            } else if (e.key === 'ArrowLeft') {
                changeSlide(-1);
            }
        });

        // CANVAS 2D TESLA ROADSTER SPACEX ROCKET SIMULATOR
        const canvas = document.getElementById('roadsterCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Roadster & SpaceX Thruster Simulation State
        let isFlying = false;
        let carX = canvas.width / 2;
        let carY = canvas.height / 2 + 50;
        let carVelY = 0;
        let carAngle = 0;
        let particles = [];
        let stars = [];

        // Generate Starfield
        for (let i = 0; i < 80; i++) {
            stars.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 1.8,
                alpha: Math.random()
            });
        }

        class Particle {
            constructor(x, y, isPlasma) {
                this.x = x;
                this.y = y;
                this.vx = (Math.random() - 0.5) * 3;
                this.vy = Math.random() * 5 + 3;
                this.size = Math.random() * 5 + 2;
                this.life = 1;
                this.decay = Math.random() * 0.04 + 0.02;
                this.isPlasma = isPlasma;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= this.decay;
                this.size *= 0.95;
            }
            draw(ctx) {
                ctx.save();
                ctx.globalAlpha = this.life;
                ctx.fillStyle = this.isPlasma ? '#00f3ff' : '#e82127';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function drawTeslaRoadster(x, y, angle) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);

            // Car Shadow / Glow Aura
            ctx.shadowColor = '#00f3ff';
            ctx.shadowBlur = isFlying ? 25 : 10;

            // Chassis Body (Red Tesla Roadster Silhouette)
            ctx.fillStyle = '#e82127';
            ctx.beginPath();
            ctx.roundRect(-35, -18, 70, 36, 10);
            ctx.fill();

            // Windshield / Cabin Glass
            ctx.fillStyle = '#06070a';
            ctx.beginPath();
            ctx.roundRect(-10, -12, 30, 24, 5);
            ctx.fill();
            ctx.strokeStyle = '#00f3ff';
            ctx.lineWidth = 1;
            ctx.stroke();

            // SpaceX Cold-Gas Thruster Nozzles (Rear)
            ctx.fillStyle = '#475569';
            ctx.fillRect(-42, -10, 8, 6);
            ctx.fillRect(-42, 4, 8, 6);

            // Headlights Glowing LED
            ctx.fillStyle = '#ffffff';
            ctx.shadowColor = '#ffffff';
            ctx.shadowBlur = 15;
            ctx.fillRect(32, -14, 4, 6);
            ctx.fillRect(32, 8, 4, 6);

            ctx.restore();
        }

        function animateCanvas() {
            ctx.fillStyle = '#06070a';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Stars
            ctx.fillStyle = '#ffffff';
            stars.forEach(s => {
                ctx.globalAlpha = s.alpha;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fill();
                s.y += isFlying ? 2 : 0.2;
                if (s.y > canvas.height) s.y = 0;
            });
            ctx.globalAlpha = 1;

            // Update Rocket Flight Logic
            if (isFlying) {
                carY += carVelY;
                carVelY -= 0.15; // Accelerate upwards
                carAngle = -Math.PI / 12;

                // Spawn SpaceX Plasma Thrust Particles
                for (let i = 0; i < 4; i++) {
                    particles.push(new Particle(carX - 35, carY + (Math.random() * 16 - 8), Math.random() > 0.4));
                }

                // Update Telemetry UI HUD
                const speed = Math.round(Math.abs(carVelY) * 350 + 1000);
                const alt = Math.round((canvas.height - carY) * 25);
                document.getElementById('telemetryThrust').innerText = "180.5 kN";
                document.getElementById('telemetrySpeed').innerText = `${speed} km/h`;
                document.getElementById('telemetryAlt').innerText = `ALT-${alt} m`;

                // Reset after flying high into orbit
                if (carY < -100) {
                    carY = canvas.height + 80;
                    carVelY = -4;
                } else if (carY > canvas.height / 2 + 50 && carVelY > 0) {
                    // Touchdown back to center
                    isFlying = false;
                    carY = canvas.height / 2 + 50;
                    carVelY = 0;
                    carAngle = 0;
                    document.getElementById('telemetryThrust').innerText = "0.0 kN";
                    document.getElementById('telemetrySpeed').innerText = "0 km/h";
                    document.getElementById('telemetryAlt').innerText = "ORBITAL-0";
                    logCLI("SpaceX Roadster Rocket Landing Completed.");
                }
            }

            // Draw Particles
            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].update();
                particles[i].draw(ctx);
                if (particles[i].life <= 0) particles.splice(i, 1);
            }

            // Draw Roadster
            drawTeslaRoadster(carX, carY, carAngle);

            requestAnimationFrame(animateCanvas);
        }

        // Click to Launch Rocket
        canvas.addEventListener('click', () => {
            isFlying = true;
            carVelY = -6;
            playRocketSound();
            logCLI("CRITICAL: SpaceX Thrusters Ignited! Tesla Roadster Ascending to Orbit.");
        });

        // Initialize Animation Loop & UI State
        window.onload = function() {
            animateCanvas();
            updateSlideUI();
            logCLI("UNIPLEA Tesla Economic Model Initialized successfully.");
        };
    </script>
</body>
